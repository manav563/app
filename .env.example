# Required in production. At least 32 random characters, for example: openssl rand -hex 32
JWT_SECRET=

# Where the SQLite file lives. Mount this path on a persistent volume.
DB_PATH=./plaza.db
PORT=3000

# Exact origin of your web app, for browser requests (leave empty to block cross-origin browsers).
ALLOWED_ORIGIN=https://your-app.example.com

# Set to 1 only when running behind a proxy you control that sets X-Forwarded-For.
TRUST_PROXY=0
